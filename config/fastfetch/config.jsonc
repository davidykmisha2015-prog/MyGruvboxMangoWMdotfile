{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/logo.png",
        "width": 22,
        "height": 11,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": " ➜ ",
        "color": {
            "keys": "cyan",
            "title": "blue"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "{user-name-colored}@{host-name-colored}"
        },
        {
            "type": "custom",
            "format": "──────────────────────────────"
        },
        {
            "type": "os",
            "key": " OS     ",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": " Kernel ",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": " WM/DE  ",
            "keyColor": "magenta"
        },
        {
            "type": "terminal",
            "key": " Term   ",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "󰏖 Pkgs   ",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": " CPU    ",
            "keyColor": "red",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU    ",
            "keyColor": "green",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": " RAM    ",
            "keyColor": "yellow"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime ",
            "keyColor": "cyan"
        },
        {
            "type": "custom",
            "format": "──────────────────────────────"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
